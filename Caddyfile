# Dedicated API host. Flutter mobile/web/desktop builds point at this URL
# so the API is reachable without going through the SPA host. Routers in
# FastAPI already carry their own `/api/...` prefix, so paths are unchanged
# (e.g. https://api.{$DOMAIN}/api/feed). DNS: A record api.{$DOMAIN} → VM IP.
api.{$DOMAIN} {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	reverse_proxy fastapi:8000

	handle_errors {
		header Content-Type application/json
		respond `{"detail":"Upstream API unavailable","status":{err.status_code}}` {err.status_code}
	}
}

{$DOMAIN}, www.{$DOMAIN} {
	# Security headers that can't be set via <meta> — handled here.
	header {
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle /api/* {
		reverse_proxy fastapi:8000
	}

	# If an upstream is down or errors on /api, never fall through to the
	# Flutter SPA's index.html — the client would try to JSON.parse it and crash.
	handle_errors {
		@api path /api/*
		header @api Content-Type application/json
		respond @api `{"detail":"Upstream API unavailable","status":{err.status_code}}` {err.status_code}
	}

	handle /admin* {
		# Admin SPA must not be indexed by search engines.
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy fastapi:8000
	}

	handle /storage/* {
		uri strip_prefix /storage
		reverse_proxy minio:9000
	}

	# Public marketing landing page — canonical URL is /landing.html.
	# Must precede the SPA catch-all so the Flutter shell never owns this path.
	# /land is kept as a permanent redirect for any old links.
	redir /land /landing.html permanent

	# Static marketing + SEO surfaces (landing, comparison, blog, og-image).
	# Plain HTML — skip the SPA's COOP/COEP so Google Fonts and embedded
	# SVGs load without cross-origin friction.
	@marketing_html path /landing.html /scrivener-alternative.html /scrivener-vs-inkspacex.html /sudowrite-vs-inkspacex.html /best-writing-software-2026.html
	handle @marketing_html {
		root * /srv/web
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}

	# OG / Twitter card images — public, long-cached.
	@og_images path /og-image.png /og-scrivener-alternative.png /og-scrivener-vs.png /og-sudowrite-vs.png /og-best-2026.png /og-blog-three-act.png /og-blog-ugly-draft.png /og-blog-switching.png
	handle @og_images {
		root * /srv/web
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Shared comparison + blog stylesheet — long-cache, immutable.
	handle /marketing.css {
		root * /srv/web
		header Content-Type "text/css; charset=utf-8"
		header Cache-Control "public, max-age=3600"
		file_server
	}

	handle /blog/* {
		root * /srv/web
		header Cache-Control "public, max-age=300, must-revalidate"
		file_server
	}

	# SEO discovery files — must precede the SPA catch-all so Googlebot gets
	# the actual text files, not the Flutter shell. Short cache so we can
	# update the sitemap without waiting on a stale CDN copy.
	handle /robots.txt {
		root * /srv/web
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=3600"
		file_server
	}

	handle /sitemap.xml {
		root * /srv/web
		header Content-Type "application/xml; charset=utf-8"
		header Cache-Control "public, max-age=3600"
		file_server
	}

	handle {
		root * /srv/web
		# skwasm renderer needs SharedArrayBuffer, which requires a
		# cross-origin-isolated context (COOP + COEP headers).
		header Cross-Origin-Opener-Policy "same-origin"
		header Cross-Origin-Embedder-Policy "credentialless"
		# Flutter web's bootstrap files don't carry content hashes in their
		# names — if the browser caches them, users keep running yesterday's
		# build forever. Force revalidate on every load. Hashed assets under
		# /assets, /canvaskit, /icons stay long-cached as normal.
		@nocache path /index.html / /main.dart.js /main.dart.js.map /flutter.js /flutter_bootstrap.js /flutter_service_worker.js /manifest.json /version.json /favicon.png
		header @nocache Cache-Control "no-cache, no-store, must-revalidate"
		header @nocache Pragma "no-cache"
		header @nocache Expires "0"
		try_files {path} /index.html
		file_server
	}
}
